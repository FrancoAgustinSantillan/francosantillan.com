---
import Base from '../layouts/Base.astro';
import {
  zonas,
  zonaDe,
  busqueda,
  LIMITE_A_PIE,
  trabajo,
  lineas,
  estaciones,
  deptos,
  estacionesCercanas,
  minutosCaminando,
  formatoDistancia,
  distancia,
  linkCaminando,
  linkTransporte,
  type Estacion,
} from '../data/roci';

const alTrabajo = (p: { lat: number; lon: number }) => (trabajo ? distancia(p, trabajo) : 0);
const resumenZonas = zonas
  .map((z) => ({ ...z, cercanas: estacionesCercanas(z.centro, 3), trabajoM: alTrabajo(z.centro) }))
  .sort((a, b) => a.trabajoM - b.trabajoM);
// Orden: descartados al final; el resto, lo más cerca del trabajo primero (o del Metro si no hay trabajo).
const lista = deptos
  .map((d, i) => ({ ...d, n: i + 1, cercanas: estacionesCercanas(d, 2), trabajoM: alTrabajo(d), ...zonaDe(d) }))
  .sort(
    (a, b) =>
      (a.estado === 'descartado' ? 1 : 0) - (b.estado === 'descartado' ? 1 : 0) ||
      (trabajo ? a.trabajoM - b.trabajoM : a.cercanas[0].metros - b.cercanas[0].metros),
  );

const requisitos = (d: (typeof deptos)[number]) => [
  { label: 'Amueblada', v: d.amueblada },
  { label: 'Servicios incluidos', v: d.servicios },
  { label: 'Solo mujeres', v: d.soloMujeres },
  { label: 'Baño propio', v: d.banoPropio, opcional: true },
];
const icono = (v: boolean | undefined) => (v === true ? '✓' : v === false ? '✗' : '?');
const claseReq = (v: boolean | undefined, opcional?: boolean) =>
  v === true ? 'req req-si' : v === false ? (opcional ? 'req req-no-opc' : 'req req-no') : 'req req-nose';

const badges = (e: Estacion) => e.lineas.map((l) => ({ l, ...lineas[l] }));
const aPie = (m: number) => (m <= LIMITE_A_PIE ? `~${minutosCaminando(m)} min a pie` : 'lejos para caminar');
const aPieCorto = (m: number) => (m <= LIMITE_A_PIE ? `~${minutosCaminando(m)} min` : 'lejos');
const ruta = (d: { lat: number; lon: number }, e: Estacion & { metros: number }) => (e.metros <= LIMITE_A_PIE ? linkCaminando(d, e) : linkTransporte(d, e));
const etiquetaZona = (d: { dentro: boolean; zona: { nombre: string } }) => (d.dentro ? d.zona.nombre : `Cerca de ${d.zona.nombre}`);

const mapa = {
  zonas: zonas.map((z) => ({ nombre: z.nombre, bbox: z.bbox })),
  trabajo,
  lineas,
  estaciones,
  deptos: deptos.map((d, i) => ({ ...d, n: i + 1 })),
};
---
<Base title="Cuarto con roomies" description="Búsqueda de cuarto con roomies para Roci en CDMX y Naucalpan." noindex>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
  </Fragment>

  <header class="page-head">
    <h1>Cuarto con roomies 🏠</h1>
    <p class="tagline">
      Opciones para Roci cerca de su trabajo en Naucalpan, con la distancia de cada una al trabajo y al Metro.
      La vamos completando a medida que aparezcan lugares.
    </p>
  </header>

  <section class="busqueda">
    <h2>Qué busca</h2>
    <dl>
      <div><dt>Tipo</dt><dd>{busqueda.tipo}</dd></div>
      <div><dt>Presupuesto</dt><dd>{busqueda.presupuesto}</dd></div>
      <div><dt>Zonas</dt><dd>{busqueda.zonas}</dd></div>
      <div><dt>Indispensable</dt><dd>{busqueda.indispensable.join(' · ')}</dd></div>
      <div><dt>Preferible</dt><dd>{busqueda.preferible.join(' · ')}</dd></div>
      <div><dt>Le da igual</dt><dd>{busqueda.indiferente.join(' · ')}</dd></div>
      <div><dt>Desde</dt><dd>{busqueda.desde}</dd></div>
      <div><dt>Plazo</dt><dd>{busqueda.plazo}</dd></div>
    </dl>
  </section>

  <div id="mapa" class="mapa" aria-label="Mapa de las zonas con estaciones de Metro"></div>
  <p class="leyenda">
    <span><i class="dot" style={`background:${lineas[2].color}`}></i>Metro Línea 2</span>
    <span><i class="dot" style={`background:${lineas[6].color}`}></i>Metro Línea 6</span>
    <span><i class="dot" style={`background:${lineas[7].color}`}></i>Metro Línea 7</span>
    <span><i class="dot dot-depto"></i>Depto</span>
    <span><i class="zona-sw"></i>Zonas de búsqueda</span>
    {trabajo && <span>💼 Trabajo (aprox.)</span>}
  </p>

  <section>
    <h2>Las zonas</h2>
    <p class="muted small">Ordenadas de la más cercana a la más lejana del trabajo. Distancias desde el centro de cada zona; cada depto tiene su propio cálculo más abajo.</p>
    <div class="zonas">
      {resumenZonas.map((z) => (
        <div class="zona">
          <div class="zona-head">
            <h3>{z.nombre}</h3>
            {trabajo && <span class="zona-trabajo">💼 {formatoDistancia(z.trabajoM)} del trabajo</span>}
          </div>
          <p class="muted small">{z.donde}</p>
          <ul class="estaciones">
            {z.cercanas.map((e) => (
              <li>
                <span class="est-nombre">
                  {badges(e).map((b) => <span class="linea" style={`background:${b.color}`} title={b.nombre}>{b.l}</span>)}
                  {e.nombre}
                </span>
                <span class="est-dist">{formatoDistancia(e.metros)} · {aPie(e.metros)}</span>
              </li>
            ))}
          </ul>
          {z.nota && <p class="zona-nota">⚠️ {z.nota}</p>}
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Deptos y cuartos</h2>
    {lista.length === 0 ? (
      <div class="vacio">
        <p><strong>Todavía no hay domicilios cargados.</strong></p>
        <p class="muted">Cuando aparezca un lugar, lo sumamos acá con su distancia al Metro y el link para ver la ruta caminando.</p>
      </div>
    ) : (
      <div class="deptos">
        {lista.map((d) => {
          return (
            <article class:list={['depto', d.estado === 'descartado' && 'descartado']}>
              <div class="depto-head">
                <h3><span class="num">{d.n}</span>{d.titulo}</h3>
                {d.estado && <span class={`estado estado-${d.estado.replace(' ', '-')}`}>{d.estado}</span>}
              </div>
              <p class="dir">{d.direccion}</p>
              <p class="zona-tag">📍 {etiquetaZona(d)}</p>
              {d.precio && <p class="precio">{d.precio}</p>}
              <ul class="reqs">
                {requisitos(d).map((r) => <li class={claseReq(r.v, r.opcional)}>{icono(r.v)} {r.label}</li>)}
              </ul>
              <ul class="metro">
                {d.cercanas.map((e) => (
                  <li>
                    <span class="est-nombre">
                      {badges(e).map((b) => <span class="linea" style={`background:${b.color}`}>{b.l}</span>)}
                      {e.nombre}
                    </span>
                    <span class="est-dist">
                      {formatoDistancia(e.metros)} · {aPieCorto(e.metros)}
                      · <a href={ruta(d, e)} target="_blank" rel="noopener">ruta</a>
                    </span>
                  </li>
                ))}
              </ul>
              {trabajo && (
                <p class="trabajo-dist">
                  💼 Al trabajo: {formatoDistancia(d.trabajoM)} en línea recta ·{' '}
                  <a href={linkTransporte(d, trabajo)} target="_blank" rel="noopener">cómo llegar</a>
                </p>
              )}
              {d.notas && <p class="notas">{d.notas}</p>}
              {d.link && <p><a href={d.link} target="_blank" rel="noopener">Ver anuncio →</a>{d.fuente && <span class="muted small"> · {d.fuente}</span>}</p>}
            </article>
          );
        })}
      </div>
    )}
  </section>

  <section>
    <h2>Trabajo</h2>
    {trabajo ? (
      <p>💼 {trabajo.direccion}. <span class="muted">En el mapa está marcado de forma aproximada.</span></p>
    ) : (
      <p class="muted">Todavía no tenemos la dirección del trabajo.</p>
    )}
  </section>

  <p class="muted small nota-calc">
    Las distancias se miden en línea recta hasta la estación. Los minutos a pie son un estimado (suman ~30 % por las calles, a paso normal).
    Para la ruta exacta, usá el link <em>ruta</em>, que abre Google Maps (a pie si queda cerca, en transporte público si no).
  </p>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
  <script is:inline define:vars={{ mapa }}>
    const L = window.L;
    const map = L.map('mapa', { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    const puntos = [];
    for (const z of mapa.zonas) {
      const [s, n, w, e] = z.bbox;
      L.rectangle([[s, w], [n, e]], { color: '#2f5bd3', weight: 2, dashArray: '6 4', fillOpacity: 0.06 })
        .addTo(map)
        .bindTooltip(z.nombre, { permanent: true, direction: 'center', className: 'zona-label' });
      puntos.push([s, w], [n, e]);
    }
    for (const est of mapa.estaciones) {
      const color = mapa.lineas[est.lineas[0]].color;
      const m = L.circleMarker([est.lat, est.lon], {
        radius: 8, color: '#fff', weight: 2, fillColor: color, fillOpacity: 1,
      }).addTo(map);
      if (est.lineas.length > 1) {
        L.circleMarker([est.lat, est.lon], { radius: 11, color: mapa.lineas[est.lineas[1]].color, weight: 3, fill: false }).addTo(map);
      }
      m.bindTooltip(`Metro ${est.nombre} (L${est.lineas.join(', L')})`);
    }

    const pin = (html, cls) => L.divIcon({ html, className: cls, iconSize: [28, 28], iconAnchor: [14, 14] });
    for (const d of mapa.deptos) {
      L.marker([d.lat, d.lon], { icon: pin(String(d.n), 'pin-depto') })
        .addTo(map)
        .bindPopup(`<strong>${d.n}. ${d.titulo}</strong><br>${d.direccion}${d.precio ? '<br>' + d.precio : ''}`);
      puntos.push([d.lat, d.lon]);
    }
    if (mapa.trabajo) {
      L.marker([mapa.trabajo.lat, mapa.trabajo.lon], { icon: pin('💼', 'pin-trabajo') })
        .addTo(map)
        .bindPopup(`<strong>Trabajo</strong><br>${mapa.trabajo.direccion}`);
      puntos.push([mapa.trabajo.lat, mapa.trabajo.lon]);
    }
    // Encuadrar todas las zonas y lo que esté cargado.
    map.fitBounds(puntos, { padding: [20, 20], maxZoom: 16 });
  </script>
</Base>

<style>
  .mapa { margin-top: 40px; height: 380px; border-radius: 12px; border: 1px solid var(--line); z-index: 0; }
  .leyenda { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.85rem; color: var(--muted); margin: 10px 0 0; }
  .leyenda span { display: inline-flex; align-items: center; gap: 6px; }
  .dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; border: 2px solid #fff; box-shadow: 0 0 0 1px var(--line); }
  .dot-depto { background: #7c3aed; }
  .zona-sw { width: 16px; height: 11px; border: 2px dashed #2f5bd3; display: inline-block; border-radius: 2px; }
  .small { font-size: 0.9rem; }
  .busqueda dl { display: grid; gap: 6px; margin: 0; padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .busqueda dl div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; }
  .busqueda dt { color: var(--muted); }
  .busqueda dd { margin: 0; }
  @media (max-width: 480px) { .busqueda dl div { grid-template-columns: 1fr; gap: 0; } }
  .zona-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .zona-trabajo { font-size: 0.9rem; font-weight: 600; }
  .reqs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .req { font-size: 0.78rem; padding: 2px 8px; border-radius: 99px; border: 1px solid; }
  .req-si { color: var(--green); }
  .req-no { color: #d6001c; }
  .req-no-opc { color: var(--muted); }
  .req-nose { color: var(--muted); border-style: dashed; }
  .zonas { display: grid; gap: 12px; margin-top: 12px; }
  .zona { padding: 14px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .zona h3 { margin: 0; font-size: 1.05rem; }
  .zona > p { margin: 2px 0 6px; }
  .zona .estaciones li:last-child { border-bottom: 0; }
  .zona-nota { font-size: 0.9rem; color: var(--amber); margin: 8px 0 0 !important; }
  .zona-tag { font-size: 0.9rem; }
  :global(.zona-label) {
    background: rgba(255, 255, 255, 0.85); border: 0; box-shadow: none; color: #2f5bd3;
    font: 600 11px/1.2 system-ui, sans-serif; padding: 2px 5px;
  }
  :global(.zona-label::before) { display: none; }

  .estaciones li, .metro li {
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    padding: 9px 0; border-bottom: 1px solid var(--line);
  }
  .metro li { padding: 6px 0; font-size: 0.95rem; }
  .metro li:last-child { border-bottom: 0; }
  .est-nombre { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; }
  .est-dist { color: var(--muted); font-variant-numeric: tabular-nums; }
  .linea {
    display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%;
    color: #fff; font-size: 0.72rem; font-weight: 700;
  }

  .vacio { padding: 20px; border: 1px dashed var(--line); border-radius: 12px; }
  .vacio p { margin: 0 0 6px; }

  .deptos { display: grid; gap: 12px; }
  .depto { padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .depto.descartado { opacity: 0.5; }
  .depto-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .depto h3 { margin: 0; font-size: 1.05rem; display: flex; align-items: center; gap: 8px; }
  .num {
    display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
    background: #7c3aed; color: #fff; font-size: 0.8rem; flex-shrink: 0;
  }
  .depto p { margin: 6px 0 0; }
  .dir { color: var(--muted); }
  .precio { font-weight: 600; }
  .metro { margin-top: 10px; }
  .notas { font-size: 0.95rem; }
  .estado { font-size: 0.72rem; font-weight: 600; padding: 1px 8px; border-radius: 99px; border: 1px solid currentColor; white-space: nowrap; color: var(--muted); }
  .estado-favorito { color: #7c3aed; }
  .estado-visitado, .estado-contactado { color: var(--green); }
  .estado-por-ver { color: var(--accent); }
  .nota-calc { margin-top: 48px; }

  :global(.pin-depto), :global(.pin-trabajo) {
    display: grid; place-items: center; border-radius: 50%; font: 700 13px/1 system-ui, sans-serif;
    border: 2px solid #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }
  :global(.pin-depto) { background: #7c3aed; color: #fff; }
  :global(.pin-trabajo) { background: #fff; font-size: 15px; }
</style>
